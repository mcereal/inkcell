/*
 * The icon set: one line per icon, in the order the enum takes.
 *
 * This file is included more than once with the macro defined differently each time - once to
 * build `enum inkcell_icon`, once to build the name table, and once by scripts/gen-icons.py to
 * decide which Material Symbols glyphs to rasterise. That is what keeps the enum, the sprites
 * and the generator from drifting apart, and it is the same trick include/inkcell/i18n/catalog.def
 * plays for strings. Like that file it has no include guard, it is not a .h, and `make format`
 * leaves it alone.
 *
 *   INKCELL_ICON_ENTRY(ID, "material_symbols_name")
 *
 * `ID` is what a renderer names (INKCELL_ICON_CHEVRON); the string is the glyph the generator
 * looks up in Material Symbols Rounded, and is never read by a person - it is a font's glyph
 * name, not a word, so it stays out of the string catalog.
 *
 * Rules for a good entry:
 *
 *   - The id says what the icon *means here*, not what it draws. CHEVRON is a shape and would
 *     be a poor id if it meant one thing; it stays because a chevron means exactly one thing on
 *     every screen - "this row opens something". OFF_RADIO is a broken link; that it is drawn
 *     with link_off is the table's business, not the renderer's.
 *   - One id per job, even when two jobs share a glyph. The Nodes tab and the Status screen's
 *     mesh card both draw `hub`, and both name INKCELL_ICON_NODES, because they are saying the
 *     same thing. If they ever stop being the same thing, one of them gets its own id.
 *   - An icon nothing draws does not belong here. The sprites are generated data, and an id
 *     with no call site is a kilobyte of rodata that no theme, screen or test can see.
 *
 * Adding one is: a line here, then `python3 scripts/gen-icons.py <font> src/ui/generated/icon_glyphs.c`
 * (see the script's header for the font), then commit the regenerated data with it.
 */

/* ---- the tabs, and the empty states that stand in for them --------------------------------- */

INKCELL_ICON_ENTRY(MESSAGES,  "forum")
INKCELL_ICON_ENTRY(NODES,     "hub")
INKCELL_ICON_ENTRY(DEVICES,   "settings_input_antenna")
INKCELL_ICON_ENTRY(STATUS,    "speed")
INKCELL_ICON_ENTRY(SETTINGS,  "settings")
/* The map over the node list, on the row that opens it. Its own id rather than POSITION, which
   is a *point* - a pin says "somewhere on Earth" and this says "a picture of where things are",
   and the two are drawn side by side on the map itself: the pin marks a waypoint and this marks
   the way in. Two jobs, two ids, which is the rule at the top of this file. */
INKCELL_ICON_ENTRY(MAP,       "map")

/* ---- what a row offers --------------------------------------------------------------------- */

/* This row opens something: a settings section, an action, a node's detail. */
INKCELL_ICON_ENTRY(CHEVRON,   "chevron_right")
/* B leaves this screen for the one behind it. Its own id rather than a mirrored CHEVRON,
   because a chevron on a row is an offer the cursor takes and this is a statement about the
   whole screen - and because the top app bar draws both at once, the trail's separators in
   one and the leading affordance in the other. */
INKCELL_ICON_ENTRY(BACK,      "arrow_back")
/* A press on this row opens a keyboard: the value is typed, not chosen. The pencil means that
   and only that. It used to mean "this row can be changed at all", which put it on every switch
   and every checkbox in a settings list - a promise of a keyboard over a control the reader can
   already see and aim at. STEPPER below is what those rows say instead. */
INKCELL_ICON_ENTRY(EDIT,      "edit")
/* Left and Right move this row's value along, where it stands - the row is a set of values with
   no room to draw the set. A row that *can* draw its set (a switch, a checkbox, a segmented
   button, a slider) says nothing here: the control is the affordance, and a caption on it is a
   caption on something already legible.
   Drawn with `code` because that glyph is a chevron pair and nothing else at this size; what it
   is called in the font is the table's business, which is the rule at the top of this file. Not
   CHEVRON, which is a single mark in the trailing slot promising a screen, and not SWAP, which
   is A cycling a value rather than the d-pad stepping one. */
INKCELL_ICON_ENTRY(STEPPER,   "code")
/* Changed here and not yet written to the radio. A dot rather than a pencil: it reports state,
   it does not offer anything. */
INKCELL_ICON_ENTRY(UNSAVED,   "fiber_manual_record")
INKCELL_ICON_ENTRY(CHECK,     "check")
INKCELL_ICON_ENTRY(CLOSE,     "close")
/* This asks before it acts, and what it would do cannot be taken back - a reboot drops the
   link, a NodeDB reset empties the roster. The one icon a dialog draws, and only when the
   answer is that kind. */
INKCELL_ICON_ENTRY(WARNING,   "warning")

/* ---- who and where --------------------------------------------------------------------------
 *
 * A row's *identity* is not here and should not be: the conversation, node, picker and device
 * lists all carry a tinted disc, and what goes in one is initials the nav layer answers with.
 * These are the discs whose row is not somebody - a place, a view, a button - plus the two
 * things a device row's disc says instead. */

INKCELL_ICON_ENTRY(CHANNEL,   "tag")
INKCELL_ICON_ENTRY(BROADCAST, "public")
INKCELL_ICON_ENTRY(COMPOSE,   "add")
/* The last word in a thread was ours. */
INKCELL_ICON_ENTRY(REPLY,     "reply")
INKCELL_ICON_ENTRY(DELETE,    "delete")

/* ---- what the mesh is doing ----------------------------------------------------------------- */

INKCELL_ICON_ENTRY(BLUETOOTH, "bluetooth")
INKCELL_ICON_ENTRY(USB,       "usb")
INKCELL_ICON_ENTRY(RADIO,     "cell_tower")
INKCELL_ICON_ENTRY(LINK,      "link")

/* ---- the keyboard's action row --------------------------------------------------------------- */

INKCELL_ICON_ENTRY(SEND,       "send")
INKCELL_ICON_ENTRY(BACKSPACE,  "backspace")
INKCELL_ICON_ENTRY(SPACE,      "space_bar")
/* The layer key, on the destinations that have no word. Three of the four panels are their own
   keycap - "abc", "ABC", "#+=" - and the emoji layer's name is a face: it was drawn ":)" and
   ":)>", which is punctuation standing in for a picture, unreadable until it has been learnt
   and a translator's problem the moment it is anything else. The same mistake as the bubble's
   "ok" and "..", fixed the same way.
   MORE is the press that steps to *another* page of them rather than entering the layer, which
   is what stops three presses in a row landing on a key that looks the same. Its mark over the
   same face says "and more of these", which is the one thing that separates the two jobs. */
INKCELL_ICON_ENTRY(EMOJI,      "mood")
INKCELL_ICON_ENTRY(EMOJI_MORE, "add_reaction")

/* ---- what a settings row is about ------------------------------------------------------------
 *
 * One per section, because the settings root and the Modules list under it are the two lists
 * here that were columns of words - twenty-five rows of prose with nothing for the eye to aim
 * at, on a screen every other list gives a disc or a rune. These are the leading slot's own
 * entries, and they are the reason it has a caller at all.
 *
 * Three sections do not appear here and that is deliberate: "About radio" takes NODES' sibling
 * RADIO, Bluetooth takes BLUETOOTH and Channels takes CHANNEL, because each is saying exactly
 * what that icon already says somewhere else. A fourth id drawing the same glyph would be a
 * second sprite for one meaning. */

INKCELL_ICON_ENTRY(ABOUT,       "info")
INKCELL_ICON_ENTRY(USER,        "person")
INKCELL_ICON_ENTRY(DEVICE,      "tune")
INKCELL_ICON_ENTRY(DISPLAY,     "monitor")
INKCELL_ICON_ENTRY(POSITION,    "place")
INKCELL_ICON_ENTRY(POWER,       "battery_charging_full")
INKCELL_ICON_ENTRY(LORA,        "wifi_tethering")
INKCELL_ICON_ENTRY(SECURITY,    "shield")
/* The radio's WiFi or Ethernet interface, which is neither of the two runes already here for a
   link: LORA is the mesh and BLUETOOTH is how this client is holding on. */
INKCELL_ICON_ENTRY(NETWORK,     "lan")
INKCELL_ICON_ENTRY(MODULES,     "extension")
/* Reboot, shutdown, factory reset: the section is a list of things done to the radio rather
   than settings written to it, and the power rune is what every OS puts on that menu. */
INKCELL_ICON_ENTRY(ACTIONS,     "power_settings_new")

/* ---- the modules ----------------------------------------------------------------------------- */

INKCELL_ICON_ENTRY(MQTT,        "cloud")
INKCELL_ICON_ENTRY(STORE_FWD,   "inventory_2")
INKCELL_ICON_ENTRY(TELEMETRY,   "monitoring")
INKCELL_ICON_ENTRY(RANGE_TEST,  "straighten")
INKCELL_ICON_ENTRY(NEIGHBORS,   "group")
INKCELL_ICON_ENTRY(AMBIENT,     "lightbulb")
INKCELL_ICON_ENTRY(PAXCOUNTER,  "groups")
INKCELL_ICON_ENTRY(STATUS_MSG,  "campaign")
INKCELL_ICON_ENTRY(TAK,         "military_tech")
INKCELL_ICON_ENTRY(DETECTION,   "sensors")
INKCELL_ICON_ENTRY(EXT_NOTIFY,  "notifications")
INKCELL_ICON_ENTRY(TRAFFIC,     "traffic")

/* ---- what a settings row *does* ---------------------------------------------------------------
 *
 * One per verb a settings section offers, on the same terms as the section icons above: the
 * leading slot wants a symbol, and a row that is a verb rather than a value is exactly where
 * Material puts one. The node detail's action card has had these since it was written - the
 * ids there are drawn from the sections above, because a node's verbs are all *about* a
 * subject this file already names ("message this node", "verify this key"). A settings verb is
 * not about a subject; it is a thing being done, so it needs its own entries.
 *
 * Several rows share an id, and that is the rule at the top of this file rather than an
 * economy: the two factory resets are one job done to two depths, and the four share/import
 * rows are two jobs done to a channel set and to a contact. A separate sprite per row would be
 * a set of symbols the reader has to tell apart in order to learn they mean the same thing.
 */

/* Ask the radio to come back up. Its own id rather than ACTIONS' power rune, which is the
   *section* - and the two are drawn a finger apart, the section's symbol in the app bar and
   this one in the first row's disc. */
INKCELL_ICON_ENTRY(RESTART,     "restart_alt")
/* Ask it to cut its own power, which is the one row here with no way back from the client: a
   radio that is off cannot be told to come on. */
INKCELL_ICON_ENTRY(SHUTDOWN,    "power_off")
/* Put the radio back the way it left the factory - the config, or the whole of it. */
INKCELL_ICON_ENTRY(FACTORY,     "reset_settings")
/* The radio's configuration copied into its own flash, and brought back out of it. A pair, and
   drawn as a pair: the same arc, once each way. */
INKCELL_ICON_ENTRY(BACKUP,      "backup")
INKCELL_ICON_ENTRY(RESTORE,     "settings_backup_restore")
/* Go and ask whether there is a newer one - of this client, or of the radio's firmware. Not the
   action bar's X, which is a keycap and stays a letter. */
INKCELL_ICON_ENTRY(REFRESH,     "refresh")
/* Fetch it and write it over what is running. */
INKCELL_ICON_ENTRY(DOWNLOAD,    "download")
/* Step a client-side choice to the next value: the update channel, the firmware channel, the
   theme's neighbour language. A row that cycles rather than opening, which is why it is not the
   chevron. */
INKCELL_ICON_ENTRY(SWAP,        "swap_horiz")
/* The two About rows that change how this client looks and reads. */
INKCELL_ICON_ENTRY(THEME,       "palette")
INKCELL_ICON_ENTRY(LANGUAGE,    "language")
/* Put the radio on an amateur band under a call sign. The one verb in this tab that is a claim
   about the operator rather than about the hardware. */
INKCELL_ICON_ENTRY(LICENSE,     "workspace_premium")
/* Ask a Store & Forward router for what arrived while this client was away. */
INKCELL_ICON_ENTRY(HISTORY,     "history")
/* This radio's channel set, or its own contact record, as a link somebody else can take - and
   the same thing arriving the other way, typed in. */
INKCELL_ICON_ENTRY(SHARE,       "share")
INKCELL_ICON_ENTRY(IMPORT,      "add_link")

/* ---- what a row or a message is ---------------------------------------------------------------
 *
 * The two marks that were still characters in a text run. Each says a fact about the thing it
 * sits on rather than offering anything, which is the marker gutter's whole job. */

/* This node is pinned. */
INKCELL_ICON_ENTRY(PINNED,      "star")
/* This conversation has been muted: it still fills, it just does not interrupt. A bell with a
   stroke through it rather than EXT_NOTIFY's plain one, which is a *settings section* about the
   external notification module - one id per job, and these two jobs are only related by hardware.
   The Messages tab's row wears it, which is what makes a quiet badge legible as a choice rather
   than as a conversation nobody is talking in. */
INKCELL_ICON_ENTRY(MUTED,       "notifications_off")
/* This direct message was decrypted with our key pair rather than with a channel PSK, so it was
   readable by its recipient and by nobody else on the mesh. Distinct from SECURITY's shield: one
   is a section of settings, the other is a fact about one message. */
INKCELL_ICON_ENTRY(ENCRYPTED,   "lock")

/* ---- what became of a message we sent --------------------------------------------------------
 *
 * The three marks a bubble's trailing run can end in, and the reason "ok", ".." and "!!" are
 * gone from the string catalog: each was two cells of punctuation standing for a state, which
 * is the marker-gutter mistake one level in - unreadable until learnt, and a translator's
 * problem the moment it is a word. A tick, a clock and an alert circle are read without being
 * learnt, which is why every messenger draws exactly these three.
 *
 * The double tick rather than a single one: this client only ever knows two things about an
 * outbound message - that it went out, and that the mesh acknowledged it - and the ack is what
 * DELIVERED means. A single tick would be a third state nothing on the wire reports. */

/* Sent with want_ack and nothing has answered yet. */
INKCELL_ICON_ENTRY(SENDING,     "schedule")
/* The mesh acknowledged it. */
INKCELL_ICON_ENTRY(DELIVERED,   "done_all")
/* A Routing reply carrying an error: it did not get there, and the bubble says why. Its own id
   rather than WARNING's triangle - that one asks a question a dialog is about to act on, this
   one reports a fact about a message that has already happened. */
INKCELL_ICON_ENTRY(UNDELIVERED, "error")

/* ---- the app bar's own furniture ------------------------------------------------------------
 *
 * The two marks the top app bar draws itself rather than being handed, which is what earns them
 * a place in a toolkit's set: an application names neither, so there is nobody else to supply
 * them. */

/* More verbs than the bar had room for, behind one press - the overflow menu. The vertical
   three dots every platform draws there; a horizontal ellipsis reads as text that was cut
   short, which is a different thing and one this toolkit already draws with "...". */
INKCELL_ICON_ENTRY(MORE,        "more_vert")
/* The heading has become a search field, and this is what the field is for. Drawn inside the
   field rather than as the bar's leading mark, which stays the way out. */
INKCELL_ICON_ENTRY(SEARCH,      "search")
